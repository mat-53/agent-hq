# Copy this file to ".env" (same folder) and fill in only the providers you use.
# Never share or commit your real .env file.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Timeouts in seconds (0 or empty = no timeout). Defaults: 3600 / 3600 / 600.
OPENCODE_TIMEOUT=3600
CLAUDE_TIMEOUT=3600
PROVIDER_TIMEOUT=600
# Max characters of one chat message / task (default 32000).
MAX_MESSAGE_CHARS=32000
